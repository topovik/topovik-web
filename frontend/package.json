{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && bun run standalone:assets",
    "standalone:assets": "rm -rf .next/standalone/public .next/standalone/.next/static && cp -a public .next/standalone/public && mkdir -p .next/standalone/.next && cp -a .next/static .next/standalone/.next/static",
    "start": "HOSTNAME=0.0.0.0 PORT=3000 node .next/standalone/server.js",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.2.15",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
