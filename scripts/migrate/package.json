{
  "name": "topovik-migrate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.15",
  "scripts": {
    "filter-dump": "bun src/filter-dump.mjs",
    "extract-authors": "bun src/extract-authors.mjs",
    "migrate": "bun src/migrate.mjs",
    "media": "bun src/media.mjs",
