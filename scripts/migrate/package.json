    "fix-views": "bun src/fix-views.mjs",
    "convert-md": "bun src/convert-content-to-md.mjs",
    "fix-headings": "bun src/fix-headings.mjs",
    "fix-list-images": "bun src/fix-list-images.mjs",
    "cleanup-upload-formats": "bun src/cleanup-upload-formats.mjs",
    "flatten-wp-content": "bun src/flatten-wp-content.mjs",
